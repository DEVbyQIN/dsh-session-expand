{
  "name": "dsh-session-expand",
  "version": "0.1.0",
  "description": "DSH session bundle: session tabs, quote-to-chat and session Markdown export, installed once with every component switchable on the Plugins page.",
  "private": false,
  "license": "MIT",
  "author": "DEVbyQIN",
  "type": "module",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DEVbyQIN/dsh-session-expand.git"
  },
  "homepage": "https://github.com/DEVbyQIN/dsh-session-expand",
  "bugs": {
    "url": "https://github.com/DEVbyQIN/dsh-session-expand/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bundle",
    "session-tabs",
    "quote-to-chat",
    "session-markdown"
  ],
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "files": [
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "README_EN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "dsh-quote-to-chat": "0.2.0",
    "dsh-session-md": "0.1.0",
    "dsh-session-tabs": "0.1.6"
  },
  "scripts": {
    "test": "node --test test/verify.mjs",
    "pack:check": "npm pack --dry-run",
    "publish:github": "node tools/publish-to-github.mjs"
  }
}
